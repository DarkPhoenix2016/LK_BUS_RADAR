{
  "name": "bus-radar-sync-server",
  "version": "1.0.0",
  "private": true,
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc -p tsconfig.json && node -e \"require('fs').mkdirSync('dist/Resources',{recursive:true});require('fs').copyFileSync('Resources/apiEndpoints.json','dist/Resources/apiEndpoints.json')\"",
    "start": "node dist/server.js",
    "dev": "ts-node server.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "axios": "^1.8.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^5.1.0",
    "mongoose": "^8.10.0",
    "node-cron": "^4.0.5"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/node": "^22.15.31",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.3"
  }
}
